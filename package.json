{
  "name": "playwright-ui-coverage",
  "version": "0.1.1",
  "description": "See which buttons, links and inputs your Playwright E2E tests actually touch — screenshots with tested/untested overlays.",
  "license": "MIT",
  "author": "indigolain",
  "homepage": "https://indigolain.github.io/playwright-ui-coverage/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/indigolain/playwright-ui-coverage.git"
  },
  "bugs": {
    "url": "https://github.com/indigolain/playwright-ui-coverage/issues"
  },
  "main": "dist/index.js",
  "bin": {
    "playwright-ui-coverage": "dist/cli.js"
  },
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./reporter": {
      "types": "./dist/reporter.d.ts",
      "default": "./dist/reporter.js"
    },
    "./register": {
      "types": "./dist/register.d.ts",
      "default": "./dist/register.js"
    },
    "./config": {
      "types": "./dist/config.d.ts",
      "default": "./dist/config.js"
    },
    "./coverage.schema.json": "./schema/coverage.schema.json",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "schema"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "demo": "playwright test",
    "demo:serve": "node demo/server.mjs",
    "docs:dev": "node scripts/docs.mjs dev",
    "docs:build": "node scripts/docs.mjs build",
    "docs:preview": "node scripts/docs.mjs preview",
    "docs:screenshots": "node scripts/screenshots.mjs",
    "demo:register": "UICOV_MODE=register playwright test",
    "demo:sharded": "node scripts/check-sharding.mjs",
    "check:rebuild": "npm run build && node scripts/check-rebuild.mjs",
    "perf": "npm run build && node scripts/perf-report.mjs",
    "check:interactivity": "npm run build && node scripts/check-interactivity.mjs",
    "check:locators": "npm run build && node scripts/check-locators.mjs",
    "check:baseline": "npm run build && node scripts/check-baseline.mjs",
    "example:ct": "node scripts/example-ct.mjs",
    "example:ct:register": "node scripts/example-ct.mjs register",
    "test": "vitest run --dir test",
    "prepublishOnly": "npm run build && npm test",
    "changeset": "changeset",
    "version-packages": "changeset version && npm install --package-lock-only",
    "release": "changeset publish"
  },
  "keywords": [
    "playwright",
    "e2e",
    "coverage",
    "ui-coverage",
    "testing",
    "reporter"
  ],
  "peerDependencies": {
    "@playwright/test": ">=1.50.0"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.3",
    "@playwright/test": "^1.50.0",
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2",
    "typescript6": "npm:typescript@^6.0.3",
    "vitest": "^5.1.0"
  }
}
